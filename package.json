{
  "name": "pievy",
  "private": true,
  "description": "An open-source ecosystem of lightweight, modular JavaScript utilities.",
  "keywords": [
    "javascript",
    "libraries",
    "modular",
    "open-source",
    "pievy",
    "toolkit",
    "typescript",
    "utilities",
    "utility"
  ],
  "license": "MIT",
  "author": {
    "name": "Amin Arabi",
    "email": "amincs@outlook.com"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:release": "changeset publish",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:ui": "turbo run test -- --ui"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/ui": "^5.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
