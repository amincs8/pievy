{
  "name": ${packageNameJson},
  "description": ${descriptionJson},
  "keywords": ${keywordsJson},
  "license": "MIT",
  "author": ${authorJson},
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
